# Python
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
*.egg-info/

# VOD data — personal, large, never commit
work/
out/
vods/

# Music — copyrighted MP3s
music/*.mp3
music/*.wav
music/*.m4a
music/*.aac
music/*.ogg
music/*.flac
music.zip

# Filler videos — copyrighted, too large for GitHub
fillers/**/*.mp4
fillers/**/*.mkv
fillers/**/*.mov
fillers/**/*.avi

# Stinger / transition videos
stingers/*.mp4
stingers/*.mkv
stingers/*.mov
stingers/*.avi

# SFX audio
sfx/*.mp3
sfx/*.wav
sfx/*.m4a
sfx/*.ogg
sfx/*.flac

# macOS
.DS_Store

# Runtime logs
*.log

# Partial downloads
*.part
*.ytdl
*.crdownload
